  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "echo Ok"
  },
  "dependencies": {
    "@swan-io/boxed": "^3.2.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./operators": {
      "types": "./dist/operators.d.ts",
      "require": "./dist/operators.js",
      "import": "./dist/operators.js"
    },
    "./promises": {
      "types": "./dist/promises.d.ts",
      "require": "./dist/promises.js",
      "import": "./dist/promises.js"
    },
    "./list": {
      "types": "./dist/list.d.ts",
      "require": "./dist/list.js",
      "import": "./dist/list.js"
    },
    "./function": {
      "types": "./dist/function.d.ts",
      "require": "./dist/function.js",
      "import": "./dist/function.js"
    },
    "./dict": {
      "types": "./dist/dict.d.ts",
      "require": "./dist/dict.js",
      "import": "./dist/dict.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
